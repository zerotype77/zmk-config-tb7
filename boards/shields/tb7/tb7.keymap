// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {

// 로터리 엔코더에 마우스 동작을 반영하기 위한 코드.
behaviors {
inc_dec_msc: sensor_rotation_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <100>;
        };
    };


    keymap {
        compatible = "zmk,keymap";

// 0번 레이어
        default_layer {
            bindings = <
// 테스트 키보드 3x2 레이아웃. 4열에 엔코더 x2개
//            |      0-0      |      0-1      |      0-2     |   0-3 엔코더키   |
//            |      1-0      |      1-1      |      1-2     |   1-3 엔코더키   |
                &mmv MOVE_UP    &mmv MOVE_DOWN       &mo 1           &kp L
                &kp RIGHT       &kp LEFT             &mkp MCLK       &kp R
            >;
            /* 엔코더 정의 */
            //            sensor-bindings = <
            //                    &inc_dec_kp C_VOL_DN C_VOL_UP
            //                    &inc_dec_kp PG_DN PG_UP
            //>;
// 시도2-1에서 수정한 코드
            sensor-bindings = <&inc_dec_msc SCRL_DOWN SCRL_UP   &inc_dec_kp RIGHT LEFT>;
        };

// 1번 레이어        
        adjust_layer {
            bindings = <
// 테스트 키보드 3x2 레이아웃. 4열에 엔코더 x2개
//            |      0-0      |      0-1      |      0-2     |   0-3 엔코더키   |
//            |      1-0      |      1-1      |      1-2     |   1-3 엔코더키   |

                &msc SCRL_LEFT  &msc SCRL_RIGHT     &mkp MCLK     &kp X
                &msc SCRL_UP    &msc SCRL_DOWN      &kp N5        &kp Y
            >;
            sensor-bindings = <&inc_dec_kp RIGHT LEFT   &inc_dec_msc SCRL_DOWN SCRL_UP>;
            };
        };
};



/* 마우스 스크롤 정의 테스트

    behaviors {
        // 'rotate-var' 대신 일반 'rotate'로 구체적인 동작을 지정해 봅니다.
        // 이렇게 하면 인자 전달 오류를 원천 차단할 수 있습니다.
        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <30>; 
        };
    };

    behaviors {
