#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>
// #define ZMK_POINTING_DEFAULT_MOVE_VAL 600  // default: 600
// #define ZMK_POINTING_DEFAULT_SCRL_VAL 50    // default: 10
// #includeのあとのあたりにスクロール量変更の定義を追記
#define ZMK_POINTING_DEFAULT_SCRL_VAL 500
// 80 에서 200 -> 500 으로 늘렸음. 스크롤이 너무 느렸음.
// 효과가 있다. 아직도 좀 느리긴 하지만.




/{


/*
     behaviors {
       encoder_msc_down_up: encoder_msc_down_up {
           compatible = "zmk,behavior-sensor-rotate";
           label = "ENCODER_MSC_DOWN_UP";
           #sensor-binding-cells = <0>;
           bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
           tap-ms = <20>;
       };
};
*/
     behaviors {
       encoder_msc_down_up: encoder_msc_down_up {
           compatible = "zmk,behavior-sensor-rotate-var";
           label = "ENCODER_MSC_DOWN_UP";
           #sensor-binding-cells = <2>;
           bindings = <&msc>, <&msc>;
           tap-ms = <20>;
       };
};



keymap {
    compatible = "zmk,keymap";
    
    // 0번 레이어
    default_layer {
        bindings = <
        // 테스트 키보드 3x2 레이아웃. 4열에 엔코더 x2개
        //            |      0-0      |      0-1      |      0-2     |   0-3 엔코더키   |
        //            |      1-0      |      1-1      |      1-2     |   1-3 엔코더키   |
        &mmv MOVE_UP    &mmv MOVE_DOWN       &mo 1           &kp L
        &kp RIGHT       &kp LEFT             &mkp MCLK       &kp R
        >;
        /* 엔코더 정의 */
        //            sensor-bindings = <
        //                    &inc_dec_kp C_VOL_DN C_VOL_UP
        //                    &inc_dec_kp PG_DN PG_UP
        //>;
        sensor-bindings = <
              &encoder_msc_down_up SCRL_DOWN  SCRL_UP  &inc_dec_kp C_VOL_UP C_VOL_DN
        >;
        };
        
        // 1번 레이어        
        adjust_layer {
            bindings = <
            // 테스트 키보드 3x2 레이아웃. 4열에 엔코더 x2개
            //            |      0-0      |      0-1      |      0-2     |   0-3 엔코더키   |
            //            |      1-0      |      1-1      |      1-2     |   1-3 엔코더키   |
            
            &msc SCRL_LEFT  &msc SCRL_RIGHT     &mkp MCLK     &kp X
            &msc SCRL_UP    &msc SCRL_DOWN      &kp N8        &kp Y
            >;
            sensor-bindings = <
                  &inc_dec_kp C_VOL_UP C_VOL_DN    &inc_dec_kp C_VOL_UP C_VOL_DN
            >;
        };
        };
    };
    
    
    // 시도2-1에서 수정한 코드
    // sensor-bindings = <&inc_dec_msc SCRL_DOWN SCRL_UP   &inc_dec_kp RIGHT LEFT>;