            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
        };
    };

    behaviors {
        mouse_encoder_leftandright: mouse_encoder_leftandright {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
        };
    };

/ {
    behaviors {
        // 'rotate-var' 대신 일반 'rotate'로 구체적인 동작을 지정해 봅니다.
        // 이렇게 하면 인자 전달 오류를 원천 차단할 수 있습니다.
        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <30>; 
        };
    };

    keymap {
        default_layer {
            // 위에서 만든 구체적인 비헤이비어를 직접 바인딩합니다.
            sensor-bindings = <&scroll_encoder>;
        };
    };
};

/ {


    keymap {
        default_layer {
            // 이제 정의한 비헤이비어를 사용할 수 있습니다.
            sensor-bindings = <&inc_dec_msc SCRL_DOWN SCRL_UP>;
        };
    };
};

/ {
    behaviors {
        rgb_encoder: rgb_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            ...
            sensor-bindings = <&rgb_encoder>;
        }
    };
};



