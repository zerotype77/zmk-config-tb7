// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    // Define a default keymap here.
    // See https://zmk.dev/docs/development/hardware-integration/new-shield#default-keymap.
    behaviors {
        mouse_encoder_upanddown: mouse_encoder_upanddown {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
        };
    };

    behaviors {
        mouse_encoder_leftandright: mouse_encoder_leftandright {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
        };
    };


    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &msc SCRL_LEFT  &msc SCRL_RIGHT       &kp K   &kp L
                &kp T       &kp S       &mo 1   &kp R
            >;
            /* 엔코더 정의 */
            sensor-bindings = <&mouse_encoder_upanddown>;
            // kp 대신 msc 사용. &inc_dec_kp
            // 
            //    &inc_dec_kp K_SCROLL_UP    K_SCROLL_DOWN
            //    &inc_dec_kp 
            >;
        };
        

        adjust_layer {
            bindings = <
                &bt BT_SEL 0    &bt BT_SEL 1      &bt BT_SEL 2  &kp N1
                &bt BT_CLR      &kp N4            &trans        &kp N2
            >;
            sensor-bindings = <&mouse_encoder_leftandright>;
//            sensor-bindings = <
//                &msc MOVE_UP    MOVE_DOWN    
//                &msc MOVE_LEFT  MOVE_RIGHT
                >;
            };

        };
};



