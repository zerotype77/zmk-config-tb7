behaviors {
       encoder_msc_down_up: encoder_msc_down_up {
           compatible = "zmk,behavior-sensor-rotate-var";
           label = "ENCODER_MSC_DOWN_UP";
           #sensor-binding-cells = <2>;
           bindings = <&msc>, <&msc>;
           tap-ms = <20>;
       };
};

*/


keymap {
    compatible = "zmk,keymap";
    
    // 0번 레이어
    default_layer {
//        display-name = "Base";
        bindings = <

        &kp Q           &kp W           &kp E           &kp R           &kp T           &kp Y           &kp U           &kp I           &kp O           &kp P
        &kp A           &kp S           &kp D           &kp F           &kp G           &kp H           &kp J           &kp K           &kp L           &kp SEMICOLON
        &kp Z           &kp X           &kp C           &kp V           &kp B           AS(N)           &kp M           &kp COMMA       &kp DOT         &kp SLASH
        &kp LEFT_ALT    &kp LEFT_GUI    &kp LCTRL       &kp LSHFT       &kp SPACE       &mo 2           &kp CAPS        &kp RIGHT_ALT   &kp MINUS       &kp EQUAL
        >;
        /* 엔코더 정의 */ 
//        sensor-bindings = <
// 테스트를 위해.             &encoder_msc_down_up SCRL_DOWN  SCRL_UP  &inc_dec_kp C_VOL_UP C_VOL_DN
//              &inc_dec_kp C_VOL_UP C_VOL_DN  &inc_dec_kp C_VOL_UP C_VOL_DN
//        >;
};



    // 1번 레이어        
        adjust_layer {
//            display-name = "Navigation";
            bindings = <
        &trans           &trans         &trans          &trans           &trans         &trans           &kp HOME       &kp UP          &kp END          &trans         
        &trans           &trans         &trans          &trans           &trans         &kp BSPC         &kp LEFT       &kp DOWN        &kp RIGHT        &kp PG_UP
        &trans           &trans         &trans          &trans           &trans         &trans           &kp DEL        &trans          &trans           &kp PG_DN      
        &trans           &trans         &trans          &trans           &kp ENTER      &trans           &trans         &trans          &trans           &trans         
            >;
        /* 엔코더 정의 */
//            sensor-bindings = <
//                  &encoder_msc_down_up SCRL_LEFT  SCRL_RIGHT    &inc_dec_kp C_VOL_UP C_VOL_DN
//            >;
};



        // 2번 레이어        
        number_layer {
//            display-name = "Numbers";
            bindings = <
        &kp N1           &kp N2         &kp N3          &kp N4           &kp N5         &kp N6          &kp N7          &kp N8          &kp N9          &kp N0
        &trans           &trans         &trans          &trans           &trans         &kp BSPC        &kp J           &kp K           &kp L           &kp SEMICOLON
        &trans           &trans         &trans          &trans           &trans         &trans          &trans         &trans          &trans           &trans         
        &trans           &trans         &trans          &trans           &trans         &trans          &trans         &trans          &trans           &trans         
            >;
};

        extra1 {
            status = "reserved";
        };
        extra2 {
            status = "reserved";    
        };
        extra3 {
            status = "reserved";    
        };
        extra4 {
            status = "reserved";    
        };
        extra5 {
            status = "reserved";    
        };
        extra6 {
            status = "reserved";    
        };
        extra7 {
            status = "reserved";    
        };        

    };
};
